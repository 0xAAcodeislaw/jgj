  "blocks": [
    {
      "id": "b001",
      "text": "第29分翻译 · 威仪寂静分第二十九"
    },
    {
      "id": "b002",
      "text": "「须菩提！若有人言：如来若来若去，若坐若卧，是人不解我所说义。何以故？如来者，无所从来，亦无所去，故名如来。」"
    },
    {
      "id": "b003",
      "text": "原文"
    },
    {
      "id": "b004",
      "text": "「须菩提！若有人言：如来若来若去，若坐若卧，是人不解我所说义。何以故？如来者，无所从来，亦无所去，故名如来。」"
    },
    {
      "id": "b005",
      "text": "句群直译线索"
    },
    {
      "id": "b006",
      "text": "「须菩提！；若有人言：如来若来若去，若坐若卧，是人不解我所说义。；何以故？；如来者，无所从来，亦无所去，故名如来。；」"
    },
    {
      "id": "b007",
      "text": "自然白话"
    },
    {
      "id": "b008",
      "text": "如来无所从来、无所去，说明如来不是一个可以用来去坐卧定位的实体。"
    },
    {
      "id": "b009",
      "text": "关键虚词、活用和结构"
    },
    {
      "id": "b010",
      "text": "应：应当；若：假设；故：因为这样；即非／是名：先立名再破除实执"
    },
    {
      "id": "b011",
      "text": "容易误解"
    },
    {
      "id": "b012",
      "text": "本分的‘无’、‘非’多在破除固定自性，不等于把日常因果和行动全部抹掉；宗教果报句按经文语境读，不替代现实判断。"
    },
    {
      "id": "b013",
      "text": "一句话记忆画面"
    },
    {
      "id": "b014",
      "text": "风过竹林，没有一片叶子能指出风从哪里来。"
    },
    {
      "id": "b015",
      "text": "记忆插画：仅作教学类比，不是经文历史事件或宗教实相图。"
    }
  ]
}
