      "id": "b001",
      "text": "若见诸相非相，则见如来"
    },
    {
      "id": "b002",
      "text": "若见诸相非相，则见如来"
    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "若看见相并理解它不具固定自性，才没有把如来缩成外貌。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "把观察与松开执著放在同一个动作里。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "看见＋看破固定化。"
    }
  ]
