      "id": "b001",
      "text": "过去心不可得，现在心不可得，未来心不可得"
    },
    {
      "id": "b002",
      "text": "过去心不可得，现在心不可得，未来心不可得"
    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "三时心念都不能被固定占有。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "把注意力带回当下正在观察的事实。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "过去／现在／未来三次不可得。"
    }
  ]
}
