  "blocks": [
    {
      "id": "b001",
      "text": "法平等，无有高下"
    },
    {
      "id": "b002",
      "text": "法平等，无有高下"
    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "一切法在空性上不因自性而有高下。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "不把理解经文变成轻视他人的理由。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "平等不抹掉差异。"
    }
  ]
}
