    {
      "id": "b001",
      "text": "梦幻泡影偈"
    },
    {
      "id": "b002",
      "text": "一切有为法，如梦幻泡影，如露亦如电，应作如是观。"
    },
    {
      "id": "b003",
      "text": "核心方法"
    },
    {
      "id": "b004",
      "text": "一切有为法，如梦幻泡影，如露亦如电，应作如是观。"
    },
    {
      "id": "b005",
      "text": "具体步骤"
    },
    {
      "id": "b006",
      "text": "按梦、幻、泡、影、露、电六拍朗读，最后接‘应作如是观’。"
    },
    {
      "id": "b007",
      "text": "边界"
    },
    {
      "id": "b008",
      "text": "这是学习方法，不是宗教修证认证；也不承诺治疗失眠。"
    },
    {
      "id": "b009",
      "text": "视觉锚点"
    },
    {
      "id": "b010",
      "text": "六个短暂画面顺次闪过。"
    }
  ]
}
