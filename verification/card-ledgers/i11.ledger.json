    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "说法需要语言，但语言不能封死所说之法。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "鼓励解释时保留语境和边界。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "有说而不实执所说。"
    }
  ]
