      "id": "b001",
      "text": "无我、无人、无众生、无寿者"
    },
    {
      "id": "b002",
      "text": "无我、无人、无众生、无寿者"
    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "四相都不应被当作固定自体。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "帮助辨认‘我在做功德’的占有式念头。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "四相反复出现，是全经主旋律。"
    }
  ]
}
