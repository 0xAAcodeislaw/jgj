    {
      "id": "b001",
      "text": "一切有为法，如梦幻泡影"
    },
    {
      "id": "b002",
      "text": "一切有为法，如梦幻泡影"
    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "一切因缘造作的现象都像梦幻、泡沫、影子一样短暂。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "面对变化时保留行动，同时不把暂时当永恒。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "梦、幻、泡、影、露、电。"
    }
  ]
}
