    {
      "id": "b001",
      "text": "不惊、不怖、不畏"
    },
    {
      "id": "b002",
      "text": "不惊、不怖、不畏"
    },
    {
      "id": "b003",
      "text": "经文义"
    },
    {
      "id": "b004",
      "text": "面对甚深经义时不被惊恐和疑惧完全牵走。"
    },
    {
      "id": "b005",
      "text": "白话理解"
    },
    {
      "id": "b006",
      "text": "用作低压力学习提醒，不把暂时困惑当失败。"
    },
    {
      "id": "b007",
      "text": "今日迁移"
    },
    {
      "id": "b008",
      "text": "把它当作观察和行动的提示，不当作万能口号或宗教功效保证。"
    },
    {
      "id": "b009",
      "text": "记忆抓手"
    },
    {
      "id": "b010",
      "text": "惊是突然受震，怖畏是持续害怕。"
    }
  ]
}
